{
  "name": "word-rumble",
  "version": "0.1.0",
  "private": true,
  "description": "Word Rumble - a cartoon crossword tile word game for Shane & Dawn",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "node scripts/package.mjs",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "assets:sounds": "node scripts/render-sounds.mjs",
    "studio:render": "node scripts/studio/render.mjs",
    "studio:promote": "node scripts/studio/promote.mjs",
    "studio:levels": "node scripts/studio/levels.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.1"
  }
}
