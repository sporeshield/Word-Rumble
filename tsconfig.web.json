{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": { "@art/*": ["./resources/art/*"], "@fonts/*": ["./resources/fonts/*"] }
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "tests/**/*"]
}
